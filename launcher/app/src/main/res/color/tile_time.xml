<?xml version="1.0" encoding="utf-8"?>
<!-- Prayer time: amber for the next prayer of the day, dark when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#10202F" />
    <item android:state_selected="true" android:color="#FFD166" />
    <item android:color="#FFFFFFFF" />
</selector>
