<?xml version="1.0" encoding="utf-8"?>
<!-- Prayer name: highlighted while it is the next prayer, dark when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#10202F" />
    <item android:state_selected="true" android:color="#EAF2FA" />
    <item android:color="#A8BCD0" />
</selector>
