<?xml version="1.0" encoding="utf-8"?>
<!-- Five-minute prayer reminder: dark glass with an amber edge, on top of Home. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F00B1B2B" />
            <corners android:radius="20dp" />
            <stroke
                android:width="2dp"
                android:color="#8CFFD166" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#14FFD166"
                android:startColor="#24FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
