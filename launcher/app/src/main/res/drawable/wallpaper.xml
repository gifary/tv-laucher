<?xml version="1.0" encoding="utf-8"?>
<!-- Home wallpaper: Masjid an-Nabawi at dusk, dimmed at the top and bottom so
     the clock, the tabs and the app cards stay readable over the photo. The
     photo and the screen share a 16:9 shape, so filling the layer does not
     distort it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/medina2" />
    </item>

    <!-- Cinematic scrim: dark under the header and the favourite row, almost
         clear across the mosque so the photo still reads. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#3308101C"
                android:centerY="0.55"
                android:endColor="#A608101C"
                android:startColor="#7308101C" />
        </shape>
    </item>
</layer-list>
