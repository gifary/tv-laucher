<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep, calm base so white text and bright focus cards stay readable. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#0B1522"
                android:centerColor="#12263A"
                android:endColor="#0C1A2A"
                android:centerY="0.5" />
        </shape>
    </item>
    <!-- Warm sunrise glow in the top-right corner: friendly without glare. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="86%"
                android:centerY="4%"
                android:gradientRadius="900dp"
                android:startColor="#33FFB35C"
                android:endColor="#00FFB35C" />
        </shape>
    </item>
    <!-- Soft teal glow at the bottom-left keeps the dark theme from feeling cold. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="4%"
                android:centerY="100%"
                android:gradientRadius="820dp"
                android:startColor="#2622C7B8"
                android:endColor="#0022C7B8" />
        </shape>
    </item>
</layer-list>
