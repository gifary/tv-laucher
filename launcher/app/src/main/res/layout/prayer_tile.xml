<?xml version="1.0" encoding="utf-8"?>
<!-- One prayer time of the day, e.g. Ashar / 14:43. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="96dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_weight="1"
    android:background="@drawable/content_card"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- duplicateParentState: the labels follow the card's focused/selected
         state, so the next prayer stays highlighted under the amber glass. -->
    <TextView
        android:id="@+id/tile_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 600"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/tile_name"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tile_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:duplicateParentState="true"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 700"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/tile_time"
        android:textSize="26sp" />
</LinearLayout>
