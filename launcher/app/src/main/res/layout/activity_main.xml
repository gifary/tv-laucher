<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wallpaper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <!-- Clock, tabs and utility buttons: large type, generous targets. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="58sp" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.01"
                    android:textColor="#B3D2E2F0"
                    android:textSize="17sp" />

                <!-- Next prayer time, e.g. "Ashar 14:43". -->
                <TextView
                    android:id="@+id/prayer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="0.01"
                    android:textColor="#FFD166"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Segmented Home / Prayer Time switch: a glass track with a
                 capsule that slides under the open page. -->
            <FrameLayout
                android:id="@+id/tab_track"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_gravity="top"
                android:background="@drawable/tab_track"
                android:padding="4dp">

                <View
                    android:id="@+id/tab_thumb"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:background="@drawable/tab_thumb"
                    android:visibility="invisible" />

                <LinearLayout
                    android:id="@+id/tab_segments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tab_home"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 700"
                        android:gravity="center"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp"
                        android:text="@string/tab_home"
                        android:textColor="@color/tab_text"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tab_prayer"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 700"
                        android:gravity="center"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="@string/tab_prayer"
                        android:textColor="@color/tab_text"
                        android:textSize="17sp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/pills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <ImageView
                    android:id="@+id/pill_inputs"
                    style="@style/PillIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/pill_inputs_description"
                    android:src="@drawable/ic_input" />

                <ImageView
                    android:id="@+id/pill_wifi"
                    style="@style/PillIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/pill_wifi_description"
                    android:src="@drawable/ic_wifi" />

                <ImageView
                    android:id="@+id/pill_settings"
                    style="@style/PillIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/pill_settings_description"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Home: clock grid, verse strip and the favourites dock. -->
            <LinearLayout
                android:id="@+id/page_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="4dp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 700"
                    android:letterSpacing="0.06"
                    android:text="@string/section_apps"
                    android:textColor="#FFD166"
                    android:textSize="18sp" />

                <dev.gtv.launcher.FocusRecyclerView
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="4dp"
                    android:clipChildren="true"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp" />

                <!-- A random Quran verse above the dock; hidden text keeps the
                     space reserved so the dock never jumps while it loads. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/verse"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="2"
                        android:textColor="#C7D7E6F2"
                        android:textDirection="ltr"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/verse_ref"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 700"
                        android:textColor="#FFD166"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="98dp"
                    android:layout_marginTop="4dp">

                    <dev.gtv.launcher.GlowView
                        android:id="@+id/glow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/dock_band"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <dev.gtv.launcher.FocusRecyclerView
                            android:id="@+id/dock"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="horizontal"
                            android:overScrollMode="never" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Prayer Time: full schedule, random Quran, hadith and videos. -->
            <ScrollView
                android:id="@+id/page_prayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:letterSpacing="0.06"
                            android:text="@string/section_prayer_times"
                            android:textColor="#FFD166"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/prayer_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:textColor="#93A8BF"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/prayer_next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 700"
                        android:textColor="#FFD166"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/schedule_row1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/schedule_row2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal" />

                    <!-- Random Quran -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:letterSpacing="0.06"
                            android:text="@string/section_quran"
                            android:textColor="#FFD166"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:textColor="#93A8BF"
                            android:textSize="13sp"
                            android:text="@string/hint_ok_new" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/quran_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/content_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/quran_arab"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="sans"
                            android:gravity="end"
                            android:lineSpacingExtra="6dp"
                            android:textColor="@color/content_text"
                            android:textDirection="rtl"
                            android:textSize="30sp" />

                        <TextView
                            android:id="@+id/quran_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:duplicateParentState="true"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:gravity="start"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/content_text"
                            android:textDirection="ltr"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/quran_ref"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:duplicateParentState="true"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:textColor="@color/content_ref"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Random hadith -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:letterSpacing="0.06"
                            android:text="@string/section_hadith"
                            android:textColor="#FFD166"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:textColor="#93A8BF"
                            android:textSize="13sp"
                            android:text="@string/hint_ok_new" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/hadith_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/content_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/hadith_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:gravity="start"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/content_text"
                            android:textDirection="ltr"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/hadith_ref"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:duplicateParentState="true"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:textColor="@color/content_ref"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Videos: a 4-wide grid is filled in code from the API. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:letterSpacing="0.06"
                            android:text="@string/section_videos"
                            android:textColor="#FFD166"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:textColor="#93A8BF"
                            android:textSize="13sp"
                            android:text="@string/hint_ok_play" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/video_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- Five-minute prayer warning: an overlay that never takes focus. -->
    <LinearLayout
        android:id="@+id/alert_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="170dp"
        android:layout_marginEnd="170dp"
        android:layout_marginTop="150dp"
        android:background="@drawable/alert_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingTop="20dp"
        android:paddingEnd="32dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/alert_banner_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 700"
                android:textColor="#FFD166"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/alert_banner_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600"
                android:textColor="#EAF2FA"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 700"
            android:letterSpacing="0.12"
            android:text="@string/alert_banner_label"
            android:textColor="#FFD166"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
