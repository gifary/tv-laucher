<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wallpaper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Clock, tabs and utility buttons: large type, generous targets. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="46sp" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.01"
                    android:textColor="#B3D2E2F0"
                    android:textSize="14sp" />

                <!-- Hijri date under it, e.g. "12 Rabiul Awwal 1447 H". -->
                <TextView
                    android:id="@+id/hijri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.01"
                    android:textColor="#93A8BF"
                    android:textSize="13sp" />

                <!-- Next prayer time, e.g. "Ashar 14:43". -->
                <TextView
                    android:id="@+id/prayer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="0.01"
                    android:textColor="#FFD166"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Segmented Home / Apps / Prayer Time switch: a glass track with
                 a capsule that slides under the open page. -->
            <FrameLayout
                android:id="@+id/tab_track"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_gravity="top"
                android:background="@drawable/tab_track"
                android:padding="3dp">

                <View
                    android:id="@+id/tab_thumb"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:background="@drawable/tab_thumb"
                    android:visibility="invisible" />

                <LinearLayout
                    android:id="@+id/tab_segments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tab_home"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 700"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="@string/tab_home"
                        android:textColor="@color/tab_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tab_apps"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 700"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/tab_apps"
                        android:textColor="@color/tab_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tab_prayer"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 700"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/tab_prayer"
                        android:textColor="@color/tab_text"
                        android:textSize="15sp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/pills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="horizontal"
                android:paddingTop="2dp">

                <ImageView
                    android:id="@+id/pill_inputs"
                    style="@style/PillIcon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:contentDescription="@string/pill_inputs_description"
                    android:src="@drawable/ic_input" />

                <ImageView
                    android:id="@+id/pill_wifi"
                    style="@style/PillIcon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:contentDescription="@string/pill_wifi_description"
                    android:src="@drawable/ic_wifi" />

                <ImageView
                    android:id="@+id/pill_settings"
                    style="@style/PillIcon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:contentDescription="@string/pill_settings_description"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Home: the verse on top, the favourite cards pinned to the
                 bottom edge of the page. -->
            <LinearLayout
                android:id="@+id/page_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- A random Quran verse first; hidden text keeps the space
                     reserved so nothing jumps while it loads. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/verse"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="2"
                        android:textColor="#C7D7E6F2"
                        android:textDirection="ltr"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/verse_ref"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 700"
                        android:textColor="#FFD166"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Favourites only, tinted by the ambient glow behind them.
                     The row is pinned to the bottom of this block and grows
                     upward into a grid as more favourites are configured. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="4dp">

                    <dev.gtv.launcher.GlowView
                        android:id="@+id/glow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <dev.gtv.launcher.FocusRecyclerView
                        android:id="@+id/fav_grid"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="true"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />
                </FrameLayout>
            </LinearLayout>

            <!-- Apps: every installed launcher app, alphabetically, including
                 the favourites, so nothing becomes unreachable. -->
            <LinearLayout
                android:id="@+id/page_apps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="4dp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 700"
                    android:letterSpacing="0.06"
                    android:text="@string/section_apps"
                    android:textColor="#FFD166"
                    android:textSize="18sp" />

                <dev.gtv.launcher.FocusRecyclerView
                    android:id="@+id/app_grid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="2dp"
                    android:clipChildren="true"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />
            </LinearLayout>

            <!-- Prayer Time: full schedule, random Quran, hadith and videos. -->
            <ScrollView
                android:id="@+id/page_prayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:letterSpacing="0.06"
                            android:text="@string/section_prayer_times"
                            android:textColor="#FFD166"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/prayer_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:textColor="#93A8BF"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/prayer_next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 700"
                        android:textColor="#FFD166"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/schedule_row1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/schedule_row2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal" />

                    <!-- Random Quran -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:letterSpacing="0.06"
                            android:text="@string/section_quran"
                            android:textColor="#FFD166"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:textColor="#93A8BF"
                            android:textSize="13sp"
                            android:text="@string/hint_ok_new" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/quran_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/content_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/quran_arab"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="sans"
                            android:gravity="end"
                            android:lineSpacingExtra="6dp"
                            android:textColor="@color/content_text"
                            android:textDirection="rtl"
                            android:textSize="30sp" />

                        <TextView
                            android:id="@+id/quran_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:duplicateParentState="true"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:gravity="start"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/content_text"
                            android:textDirection="ltr"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/quran_ref"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:duplicateParentState="true"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:textColor="@color/content_ref"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Random hadith -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:letterSpacing="0.06"
                            android:text="@string/section_hadith"
                            android:textColor="#FFD166"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:textColor="#93A8BF"
                            android:textSize="13sp"
                            android:text="@string/hint_ok_new" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/hadith_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/content_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/hadith_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:gravity="start"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/content_text"
                            android:textDirection="ltr"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/hadith_ref"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:duplicateParentState="true"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:textColor="@color/content_ref"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Videos: a 4-wide grid is filled in code from the API. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:letterSpacing="0.06"
                            android:text="@string/section_videos"
                            android:textColor="#FFD166"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:textColor="#93A8BF"
                            android:textSize="13sp"
                            android:text="@string/hint_ok_play" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/video_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- Five-minute prayer warning: an overlay that never takes focus. -->
    <LinearLayout
        android:id="@+id/alert_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="170dp"
        android:layout_marginEnd="170dp"
        android:layout_marginTop="150dp"
        android:background="@drawable/alert_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingTop="20dp"
        android:paddingEnd="32dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/alert_banner_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 700"
                android:textColor="#FFD166"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/alert_banner_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600"
                android:textColor="#EAF2FA"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 700"
            android:letterSpacing="0.12"
            android:text="@string/alert_banner_label"
            android:textColor="#FFD166"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
