<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen adhan over the Masjid an-Nabawi photo: the prayer and its
     time, the place, and a glass Stop button. The screen closes on its own
     when the recording ends, so there is no timer or countdown. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ImageView
        android:id="@+id/adhan_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/adhan_scene_description"
        android:scaleType="centerCrop"
        android:src="@drawable/nabawi" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/adhan_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="34dp"
        android:paddingEnd="48dp">

        <TextView
            android:id="@+id/adhan_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 700"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="10"
            android:textColor="#F6FAFF"
            android:textSize="38sp" />

        <TextView
            android:id="@+id/adhan_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 700"
            android:includeFontPadding="false"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:textColor="#FFD166"
            android:textSize="92sp" />

        <TextView
            android:id="@+id/adhan_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 600"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="8"
            android:textColor="#F0E6D8"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/adhan_stop"
            android:layout_width="300dp"
            android:layout_height="60dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/adhan_stop_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 700"
            android:gravity="center"
            android:stateListAnimator="@animator/adhan_stop_focus"
            android:text="@string/adhan_stop"
            android:textColor="@color/adhan_stop_text"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/adhan_stop_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 600"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:text="@string/adhan_stop_hint"
            android:textColor="#DAD2C4"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/adhan_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 600"
            android:text="@string/adhan_missing_hint"
            android:textColor="#FFD166"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
